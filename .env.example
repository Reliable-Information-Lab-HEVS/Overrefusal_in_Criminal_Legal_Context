# Example .env file. Copy to .env and fill in; .env is git-ignored.
#
# The evaluation and the judge run locally with Ollama, so no key is required
# to reproduce any result. The key below is only used when rebuilding the
# translated datasets, by helpers/translate_prompts.py and
# helpers/bger_translate.py. It is never written to any output file.

DEEPL_API_KEY=your-deepl-key-here
